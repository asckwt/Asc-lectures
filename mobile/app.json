{
  "expo": {
    "name": "الأكاديمي",
    "slug": "asc-student",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "asckwt",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.asckwt.student",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "عشان تصوّر حلّك وترسله للأستاذ.",
        "NSPhotoLibraryUsageDescription": "عشان تختار صورة حلّك وترسلها للأستاذ."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07005E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.asckwt.student"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07005E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-video",
      "expo-sharing",
      [
        "expo-localization",
        {
          "forcesRTL": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "عشان تختار صورة حلّك وترسلها للأستاذ.",
          "cameraPermission": "عشان تصوّر حلّك وترسله للأستاذ."
        }
      ],
      "expo-screen-orientation"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json"
    }
  }
}
